{
  "name": "rabbit-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUN_CONFIG_DNS_RESULT_ORDER=ipv4first bun run --watch src/index.ts",
    "start": "BUN_CONFIG_DNS_RESULT_ORDER=ipv4first bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/deepseek": "0.2.16",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@hono/zod-validator": "^0.9.0",
    "ai": "^4.3.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.30.0"
  }
}
